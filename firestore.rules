rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CampusCycle enforces all business logic, validation, and permissions
    // strictly on the Express REST API via the privileged Firebase Admin SDK.
    // Direct client SDK reads and writes are blocked by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
